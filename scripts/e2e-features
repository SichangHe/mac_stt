#!/bin/sh
# Short feature checks on Apple Silicon macOS using a released or built binary.
# usage: scripts/e2e-features OUT_DIR [BINARY]
set -eu
out=$1
mkdir -p "$out"
bin=${2:-dist/mac-stt}
speech=tests/data/librispeech-dev-clean-240s
export MAC_STT_TRACE=1
limit() { perl -e 'alarm shift; exec @ARGV' "$@"; }
collect() { cp "$HOME/Library/Application Support/mac-stt/serve.log" "$out/serve.log" 2>/dev/null || true; }
trap collect EXIT
note() { printf '%s\n' "$*" | tee -a "$out/summary.txt"; }
now() { python3 -I -c 'import time;print(time.time())'; }
[ -n "${2:-}" ] || scripts/build dist
python3 -I scripts/wavtool.py prefix $speech.wav $speech.tsv 6 "$out/in6.wav" "$out/ref6.txt" >/dev/null
python3 -I scripts/wavtool.py prefix $speech.wav $speech.tsv 14 "$out/in14.wav" "$out/ref14.txt" >/dev/null
limit 1200 "$bin" setup >"$out/setup.txt" 2>&1
note "setup: $(tail -1 "$out/setup.txt")"

# 1. clipboard: default replaces it, --no-clipboard keeps it
printf 'sentinel' | pbcopy
limit 600 "$bin" transcribe "$out/in6.wav" --no-clipboard >/dev/null 2>&1
[ "$(pbpaste)" = sentinel ] && note "clipboard opt-out: PASS (sentinel unchanged)" || note "clipboard opt-out: FAIL"
limit 600 "$bin" transcribe "$out/in6.wav" >"$out/clip.stdout" 2>/dev/null
[ "$(pbpaste)" = "$(cat "$out/clip.stdout")" ] && note "clipboard default: PASS: $(pbpaste)" || note "clipboard default: FAIL"

# 2. toggle flow; a WAV file stands in for the microphone, paced at real time through the same pipeline
export MAC_STT_FAKE_MIC="$out/in14.wav"
printf 'sentinel' | pbcopy
note "toggle 1: $(limit 600 "$bin" toggle)"
sleep 15
t0=$(now)
limit 900 "$bin" toggle >"$out/toggle.txt"
t1=$(now)
note "toggle 2 returned after $(python3 -I -c "print('%.1f' % ($t1 - $t0))") s with: $(cat "$out/toggle.txt")"
[ "$(pbpaste)" = "$(cat "$out/toggle.txt")" ] && note "toggle clipboard: PASS" || note "toggle clipboard: FAIL"
note "toggle WER: $(python3 -I scripts/wavtool.py wer "$out/ref14.txt" "$out/toggle.txt") %"

# 3. recording is not blocked by a transcription still running
export MAC_STT_FAKE_MIC="$out/in6.wav"
"$bin" toggle >/dev/null
sleep 8
"$bin" toggle >"$out/overlap-a.txt" &
sleep 0.2
note "overlap: second take starts while the first finalizes: $(limit 60 "$bin" toggle)"
wait
sleep 8
limit 900 "$bin" toggle >"$out/overlap-b.txt"
note "overlap: first take: $(cat "$out/overlap-a.txt")"
note "overlap: second take: $(cat "$out/overlap-b.txt")"
"$bin" quit >/dev/null || true
grep -a 'finalize_seconds\|models ready\|recording started' "$HOME/Library/Application Support/mac-stt/serve.log" | tee -a "$out/summary.txt" || true

# 4. diarization on real multi-speaker meeting speech (AMI ES2004a seconds 300 to 345)
url=https://huggingface.co/datasets/FluidInference/ami-corpus-mirror/resolve/main/sdm/ES2004a.Mix-Headset.wav
curl --fail --location --silent --show-error --retry 3 "$url" -o "$out/ami-full.wav"
shasum -a 256 "$out/ami-full.wav" | tee "$out/ami-full.sha256"
python3 -I - "$out/ami-full.wav" "$out/ami.wav" <<'PY'
import sys, wave
w = wave.open(sys.argv[1]); r = w.getframerate()
w.setpos(300 * r); frames = w.readframes(45 * r)
o = wave.open(sys.argv[2], "wb"); o.setnchannels(w.getnchannels()); o.setsampwidth(w.getsampwidth()); o.setframerate(r)
o.writeframes(frames); o.close()
PY
rm "$out/ami-full.wav"
limit 1500 "$bin" transcribe "$out/ami.wav" --diarize --no-clipboard >"$out/ami-file.txt" 2>"$out/ami-file.err" || note "diarize file run failed"
n=$(sed -n 's/^\[[^]]*\] \([^:]*\):.*/\1/p' "$out/ami-file.txt" | sed '/^unknown$/d' | sort -u | wc -l | tr -d ' ')
note "diarization (file): $n distinct speakers"
head -8 "$out/ami-file.txt" | tee -a "$out/summary.txt"
limit 1500 "$bin" record --input "$out/ami.wav" --diarize --no-clipboard >"$out/ami-stream.txt" 2>"$out/ami-stream.err" || note "diarize stream run failed"
n=$(sed -n 's/^\[[^]]*\] \([^:]*\):.*/\1/p' "$out/ami-stream.txt" | sed '/^unknown$/d' | sort -u | wc -l | tr -d ' ')
note "diarization (streaming): $n distinct speakers"
head -8 "$out/ami-stream.txt" | tee -a "$out/summary.txt"
tr '\r' '\n' <"$out/ami-stream.err" | sed 's/\x1b\[2K//' | grep -a -v 'speech_seconds\|^$\|streaming input\|trace:' | sort -u >"$out/ami-partials.txt"
note "partials seen during the streaming take: $(wc -l <"$out/ami-partials.txt" | tr -d ' ')"
