#!/bin/sh
# Probe Core ML decoder loading. usage: scripts/probe-compute MODEL POLICY SECONDS
set -u
model=$1; policy=$2; limit=$3
swift build -c release 2>&1 | tail -1
bin=.build/release/mac-stt
"$bin" setup --model "$model" --compute "$policy" 2>&1 &
pid=$!
sleep 90
echo "== sample at 90s"; sample $pid 5 -file /tmp/sample.txt >/dev/null 2>&1; grep -E "Thread_|MLModel|ANE|E5|e5|Espresso|MIL|compile|specializ|main$|start" /tmp/sample.txt | head -60
( sleep "$limit"; echo "TIMEOUT"; kill $pid 2>/dev/null ) &
wait $pid; echo "exit=$?"
