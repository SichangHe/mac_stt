#!/bin/sh
set -eu
check_log=$(mktemp "${TMPDIR:-/tmp}/mac-stt-check.XXXXXX")
trap 'rm -f "$check_log"' EXIT
for script in scripts/build scripts/check scripts/e2e scripts/e2e-features scripts/e2e-diarize install.sh; do
    sh -n "$script"
done
if ! swift test >"$check_log" 2>&1; then
    tail -n 300 "$check_log"
    exit 1
fi
