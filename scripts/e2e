#!/bin/sh
# End-to-end test on Apple Silicon macOS: build, setup, accuracy, latency, diarization, toggle flow.
# usage: scripts/e2e OUT_DIR [BINARY]   (default binary: build from source)
set -eu
out=$1
mkdir -p "$out"
bin=${2:-.build/release/mac-stt}
data=tests/data
speech=$data/librispeech-dev-clean-240s
note() { printf '%s\n' "$*" | tee -a "$out/summary.txt"; }
[ "$(uname -m)" = arm64 ] || { echo "needs arm64" >&2; exit 1; }
{ sw_vers; sysctl -n machdep.cpu.brand_string; sysctl -n hw.memsize; } >"$out/system.txt"
cat "$out/system.txt" | tee -a "$out/summary.txt" >/dev/null

if [ -z "${2:-}" ]; then swift build -c release >"$out/build.log" 2>&1; fi
"$bin" doctor >"$out/doctor.txt" 2>&1 || true

# setup: download, verify, warm
# watchdog: a hung model load must fail the run instead of consuming the whole job timeout
"$bin" setup >"$out/setup.txt" 2>&1 &
pid=$!
( sleep 1500; kill $pid 2>/dev/null ) &
dog=$!
tail -f "$out/setup.txt" &
tailpid=$!
wait $pid || { kill $tailpid $dog 2>/dev/null; echo "setup failed or timed out" >&2; exit 1; }
kill $tailpid $dog 2>/dev/null || true
note "setup: $(cat "$out/setup.txt")"

# accuracy and speed of file transcription at several lengths
: >"$out/file-latency.tsv"
for n in 5 15 30 60 120 240; do
    len=$(python3 -I scripts/wavtool.py prefix $speech.wav $speech.tsv $n "$out/in$n.wav" "$out/ref$n.txt")
    "$bin" transcribe "$out/in$n.wav" --no-clipboard >"$out/file$n.txt" 2>"$out/file$n.err"
    secs=$(sed -n 's/.*processed in \([0-9.]*\) s.*/\1/p' "$out/file$n.err")
    w=$(python3 -I scripts/wavtool.py wer "$out/ref$n.txt" "$out/file$n.txt")
    printf '%s\t%s\t%s\n' "$len" "$secs" "$w" >>"$out/file-latency.tsv"
    note "file: speech ${len}s processed in ${secs}s WER ${w}%"
done

# streaming take: audio paced at real time, latency measured from the last sample to final text
: >"$out/stream-latency.tsv"
for n in 5 15 30 60 120 240; do
    "$bin" record --input "$out/in$n.wav" --no-clipboard >"$out/stream$n.txt" 2>"$out/stream$n.err"
    line=$(grep -a 'speech_seconds=' "$out/stream$n.err" | tail -1)
    fin=$(printf '%s' "$line" | sed -n 's/.*finalize_seconds=\([0-9.]*\).*/\1/p')
    sp=$(printf '%s' "$line" | sed -n 's/.*speech_seconds=\([0-9.]*\).*/\1/p')
    w=$(python3 -I scripts/wavtool.py wer "$out/ref$n.txt" "$out/stream$n.txt")
    printf '%s\t%s\t%s\n' "$sp" "$fin" "$w" >>"$out/stream-latency.tsv"
    note "stream: speech ${sp}s finalize ${fin}s WER ${w}%"
done

# partial results appear while recording
tr '\r' '\n' <"$out/stream60.err" | sed 's/\x1b\[2K//' | grep -a -v 'speech_seconds\|^$\|streaming input' | sort -u >"$out/stream60-partials.txt"
note "partials observed during the 60 s take: $(wc -l <"$out/stream60-partials.txt" | tr -d ' ')"

# diarization on real multi-speaker meeting speech (AMI ES2004a, seconds 300 to 390)
ami_url=https://huggingface.co/datasets/FluidInference/ami-corpus-mirror/resolve/main/sdm/ES2004a.Mix-Headset.wav
curl --fail --location --silent --show-error --retry 3 "$ami_url" -o "$out/ami-full.wav"
shasum -a 256 "$out/ami-full.wav" | tee "$out/ami-full.sha256"
python3 -I - "$out/ami-full.wav" "$out/ami.wav" <<'PY'
import sys, wave
w = wave.open(sys.argv[1]); r = w.getframerate()
w.setpos(300 * r); frames = w.readframes(90 * r)
o = wave.open(sys.argv[2], "wb"); o.setnchannels(w.getnchannels()); o.setsampwidth(w.getsampwidth()); o.setframerate(r)
o.writeframes(frames); o.close()
PY
rm "$out/ami-full.wav"
"$bin" transcribe "$out/ami.wav" --diarize --no-clipboard >"$out/ami-file.txt" 2>"$out/ami-file.err"
"$bin" record --input "$out/ami.wav" --diarize --no-clipboard >"$out/ami-stream.txt" 2>"$out/ami-stream.err"
for f in ami-file ami-stream; do
    n=$(sed -n 's/^\[[^]]*\] \([^:]*\):.*/\1/p' "$out/$f.txt" | sed '/^unknown$/d' | sort -u | wc -l | tr -d ' ')
    note "diarization $f: $n distinct speakers"
    head -8 "$out/$f.txt" | tee -a "$out/summary.txt"
done

# clipboard: opt-out keeps it, default replaces it
printf 'sentinel' | pbcopy
"$bin" transcribe "$out/in5.wav" --no-clipboard >/dev/null 2>&1
[ "$(pbpaste)" = sentinel ] && note "clipboard opt-out: PASS (sentinel unchanged)" || note "clipboard opt-out: FAIL"
"$bin" transcribe "$out/in5.wav" >"$out/clip.stdout" 2>/dev/null
if [ "$(pbpaste)" = "$(cat "$out/clip.stdout")" ]; then note "clipboard default: PASS"; else note "clipboard default: FAIL"; fi

# toggle flow with a fake microphone (a WAV file paced at real time through the real capture path)
export MAC_STT_FAKE_MIC="$out/in30.wav"
printf 'sentinel' | pbcopy
note "toggle 1: $("$bin" toggle)"
sleep 31
t0=$(python3 -I -c 'import time;print(time.time())')
"$bin" toggle >"$out/toggle30.txt"
t1=$(python3 -I -c 'import time;print(time.time())')
note "toggle 2 returned after $(python3 -I -c "print('%.3f' % ($t1 - $t0))") s"
cat "$out/toggle30.txt" | head -5
[ "$(pbpaste)" = "$(cat "$out/toggle30.txt")" ] && note "toggle clipboard: PASS" || note "toggle clipboard: FAIL"
note "toggle WER: $(python3 -I scripts/wavtool.py wer "$out/ref30.txt" "$out/toggle30.txt")%"
# recording is not blocked by a transcription in flight
export MAC_STT_FAKE_MIC="$out/in60.wav"
"$bin" toggle >/dev/null
sleep 20
"$bin" toggle >"$out/overlap-a.txt" &
sleep 0.05
note "overlap: new take started while previous finalizes: $("$bin" toggle)"
wait
sleep 5
"$bin" toggle >"$out/overlap-b.txt"
note "overlap: first take text bytes $(wc -c <"$out/overlap-a.txt" | tr -d ' '), second take text bytes $(wc -c <"$out/overlap-b.txt" | tr -d ' ')"
"$bin" quit || true
cp "$HOME/Library/Application Support/mac-stt/serve.log" "$out/serve.log" 2>/dev/null || true
grep -a 'finalize_seconds\|models ready' "$out/serve.log" | tee -a "$out/summary.txt"

# placement plans for the compiled models
for m in encoder decoder; do
    "$bin" profile-model "$HOME/Library/Application Support/mac-stt/models/qwen3-asr-1.7b/$m.mlmodelc" >"$out/placement-$m.txt" 2>&1 || true
    head -6 "$out/placement-$m.txt" | tee -a "$out/summary.txt"
done
