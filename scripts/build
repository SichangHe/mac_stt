#!/bin/sh
# Builds the release binary with xcodebuild, because SwiftPM cannot compile MLX's Metal shaders.
# Output: DIST/mac-stt and DIST/mlx.metallib (MLX looks for `mlx.metallib` next to the binary).
# usage: scripts/build DIST
set -eu
dist=$1
mkdir -p "$dist"
xcodebuild -downloadComponent MetalToolchain >/dev/null 2>&1 || true
xcodebuild build -scheme mac-stt -configuration Release -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath .xcbuild -skipPackagePluginValidation -skipMacroValidation >"$dist/build.log" 2>&1 ||
    { tail -n 80 "$dist/build.log"; exit 1; }
products=.xcbuild/Build/Products/Release
cp "$products/mac-stt" "$dist/mac-stt"
metallib=$(find "$products" -name default.metallib | head -n 1)
[ -n "$metallib" ] || { echo "no default.metallib in $products" >&2; exit 1; }
cp "$metallib" "$dist/mlx.metallib"
